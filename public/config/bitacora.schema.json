{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitacora.local/schemas/bitacora.schema.json",
  "title": "Configuración de la bitácora (bitacora.json)",
  "description": "Valida la forma del contenido de la bitácora. Los mapas y las colocaciones de las estaciones viven en maps.json (maps.schema.json). Las referencias cruzadas (IDs, assets, portales, accesibilidad del recorrido) las comprueba validateBitacora sobre ambos archivos. Las claves de los registros son los IDs estables.",
  "type": "object",
  "required": [
    "schemaVersion", "contentSetId", "configRevision", "mode", "project", "route",
    "learnings", "badges", "dialogues", "ui", "gameplay", "audio"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "contentSetId": { "$ref": "#/$defs/id" },
    "configRevision": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["demo", "final"] },
    "editorNotes": { "type": "string" },
    "project": { "$ref": "#/$defs/project" },
    "route": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "learnings": { "$ref": "#/$defs/registry-of-learning" },
    "badges": { "$ref": "#/$defs/registry-of-badge" },
    "dialogues": { "$ref": "#/$defs/registry-of-dialogue" },
    "ui": { "$ref": "#/$defs/ui" },
    "gameplay": { "$ref": "#/$defs/gameplay" },
    "audio": { "$ref": "#/$defs/audio" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "assetId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },
    "normalizedPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "registry-of-learning": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/learning" }
    },
    "registry-of-badge": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/badge" }
    },
    "registry-of-dialogue": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/dialogue" }
    },

    "contentBlock": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/block-paragraph" },
        { "$ref": "#/$defs/block-heading" },
        { "$ref": "#/$defs/block-image" },
        { "$ref": "#/$defs/block-quote" },
        { "$ref": "#/$defs/block-reference" }
      ],
      "discriminator": { "propertyName": "type" }
    },
    "block-paragraph": {
      "type": "object",
      "required": ["type", "text"],
      "properties": { "type": { "const": "paragraph" }, "text": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "block-heading": {
      "type": "object",
      "required": ["type", "text"],
      "properties": { "type": { "const": "heading" }, "text": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "block-image": {
      "type": "object",
      "required": ["type", "assetId", "alt"],
      "properties": {
        "type": { "const": "image" },
        "assetId": { "$ref": "#/$defs/assetId" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" }
      },
      "additionalProperties": false
    },
    "block-quote": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "quote" },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "block-reference": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "reference" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },

    "project": {
      "type": "object",
      "required": [
        "title", "studentName", "university", "program", "semester", "courseName",
        "teacherName", "welcomeText", "finalReflection"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "studentName": { "type": "string", "minLength": 1 },
        "university": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "semester": { "type": "string", "minLength": 1 },
        "courseName": { "type": "string", "minLength": 1 },
        "teacherName": { "type": ["string", "null"] },
        "welcomeText": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "welcomeTitle": { "type": "string", "minLength": 1 },
        "finalReflection": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" } }
      },
      "additionalProperties": false
    },


    "audio": {
      "type": "object",
      "required": ["music"],
      "properties": {
        "music": {
          "type": "object",
          "required": ["active", "tracks", "rotation", "volume", "crossfadeMs"],
          "properties": {
            "active": { "type": "boolean" },
            "tracks": { "type": "array", "items": { "$ref": "#/$defs/assetId" } },
            "rotation": { "enum": ["sequential", "shuffle"] },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "crossfadeMs": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "learning": {
      "type": "object",
      "required": ["title", "topic", "editorialStatus", "contentRevision", "badgeId", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "signTitle": { "type": "string", "minLength": 1, "maxLength": 40 },
        "illustrationAssetId": { "$ref": "#/$defs/assetId" },
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 32 }, "maxItems": 4 },
        "editorialStatus": { "enum": ["demo", "draft", "ready"] },
        "contentRevision": { "type": "integer", "minimum": 1 },
        "badgeId": { "$ref": "#/$defs/id" },
        "sections": {
          "type": "object",
          "required": ["learning", "reflection", "lived"],
          "properties": {
            "lived": { "$ref": "#/$defs/blocks" },
            "learning": { "$ref": "#/$defs/blocks" },
            "reflection": { "$ref": "#/$defs/blocks" }
          },
          "additionalProperties": false
        },
        "dialogueOverrides": { "$ref": "#/$defs/dialogueIds" }
      },
      "additionalProperties": false
    },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" } },
    "dialogueIds": {
      "type": "object",
      "properties": {
        "open": { "$ref": "#/$defs/id" },
        "locked": { "$ref": "#/$defs/id" },
        "completed": { "$ref": "#/$defs/id" },
        "reward": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },

    "badge": {
      "type": "object",
      "required": ["title", "description", "assetId", "xp"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "assetId": { "$ref": "#/$defs/assetId" },
        "xp": { "type": "integer", "minimum": 0 },
        "awardedFor": { "const": "route-complete" },
        "tone": { "enum": ["jade", "lavender", "gold"] },
        "takeaway": { "type": "string", "minLength": 1 },
        "specialType": { "enum": ["friendship", "memorial"] },
        "subtitle": { "type": "string", "minLength": 1 },
        "unlockCondition": { "type": "string", "minLength": 1 },
        "secret": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "required": ["lines"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["speaker", "text"],
            "properties": {
              "speaker": { "enum": ["vanessa", "narrator"] },
              "text": { "type": "string", "minLength": 1 },
              "portraitAssetId": { "$ref": "#/$defs/assetId" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "ui": {
      "type": "object",
      "required": ["tabs", "labels", "assets", "defaultDialogueIds"],
      "properties": {
        "presentation": {
          "type": "object",
          "required": ["assetPrefix", "labels"],
          "properties": {
            "assetPrefix": { "type": "string", "pattern": "^[a-zA-Z0-9]+(\\.[a-zA-Z0-9-]+)*\\.$" },
            "labels": {
              "type": "object",
              "required": ["subjectLabel", "heroAlt"],
              "properties": {
                "subjectLabel": { "type": "string", "minLength": 1 },
                "heroAlt": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "journalPanel": {
          "type": "object",
          "required": ["assetPrefix", "labels"],
          "properties": {
            "assetPrefix": { "type": "string", "pattern": "^[a-zA-Z0-9]+(\\.[a-zA-Z0-9-]+)*\\.$" },
            "zoneIcons": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "labels": {
              "type": "object",
              "required": ["title", "subtitle", "progressTemplate", "closePanel", "backToMap", "footerNote", "groupRangeTemplate", "groupSingleTemplate", "cardNumberTemplate", "nextRibbon", "statusCompleted", "statusAvailable", "statusLocked", "statusInProgress", "actionReread", "actionExplore", "requirementTemplate", "backToJournal", "readerSubtitleTemplate", "sectionsLabel", "sidebarTitle", "badgeObtained", "badgePending", "badgeInstructionTemplate", "viewBadge", "sectionsReadTemplate", "readingTemplate", "sectionRead", "markAndContinue", "continueReading", "seeSectionTemplate", "backToJournalAction"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "subtitle": { "type": "string", "minLength": 1 },
                "progressTemplate": { "type": "string", "minLength": 1 },
                "closePanel": { "type": "string", "minLength": 1 },
                "backToMap": { "type": "string", "minLength": 1 },
                "footerNote": { "type": "string", "minLength": 1 },
                "groupRangeTemplate": { "type": "string", "minLength": 1 },
                "groupSingleTemplate": { "type": "string", "minLength": 1 },
                "cardNumberTemplate": { "type": "string", "minLength": 1 },
                "nextRibbon": { "type": "string", "minLength": 1 },
                "statusCompleted": { "type": "string", "minLength": 1 },
                "statusAvailable": { "type": "string", "minLength": 1 },
                "statusLocked": { "type": "string", "minLength": 1 },
                "statusInProgress": { "type": "string", "minLength": 1 },
                "actionReread": { "type": "string", "minLength": 1 },
                "actionExplore": { "type": "string", "minLength": 1 },
                "requirementTemplate": { "type": "string", "minLength": 1 },
                "backToJournal": { "type": "string", "minLength": 1 },
                "readerSubtitleTemplate": { "type": "string", "minLength": 1 },
                "sectionsLabel": { "type": "string", "minLength": 1 },
                "sidebarTitle": { "type": "string", "minLength": 1 },
                "badgeObtained": { "type": "string", "minLength": 1 },
                "badgePending": { "type": "string", "minLength": 1 },
                "badgeInstructionTemplate": { "type": "string", "minLength": 1 },
                "viewBadge": { "type": "string", "minLength": 1 },
                "sectionsReadTemplate": { "type": "string", "minLength": 1 },
                "readingTemplate": { "type": "string", "minLength": 1 },
                "sectionRead": { "type": "string", "minLength": 1 },
                "markAndContinue": { "type": "string", "minLength": 1 },
                "continueReading": { "type": "string", "minLength": 1 },
                "seeSectionTemplate": { "type": "string", "minLength": 1 },
                "backToJournalAction": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "badgePanel": {
          "type": "object",
          "required": ["assetPrefix", "labels"],
          "properties": {
            "assetPrefix": { "type": "string", "pattern": "^[a-zA-Z0-9]+(\\.[a-zA-Z0-9-]+)*\\.$" },
            "labels": {
              "type": "object",
              "required": ["title", "subtitle", "obtainedTemplate", "obtained", "pending", "special", "viewBadge", "hint", "backToMap", "backToCollection", "myCollection", "closePanel", "eyebrowLearning", "eyebrowSpecial", "stillPending", "represents", "howEarned", "howToEarn", "completingTemplate", "completeTemplate", "completeRoute", "routeEarned", "takeaway", "viewLearning", "xpTemplate"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "subtitle": { "type": "string", "minLength": 1 },
                "obtainedTemplate": { "type": "string", "minLength": 1 },
                "obtained": { "type": "string", "minLength": 1 },
                "pending": { "type": "string", "minLength": 1 },
                "special": { "type": "string", "minLength": 1 },
                "viewBadge": { "type": "string", "minLength": 1 },
                "hint": { "type": "string", "minLength": 1 },
                "backToMap": { "type": "string", "minLength": 1 },
                "backToCollection": { "type": "string", "minLength": 1 },
                "myCollection": { "type": "string", "minLength": 1 },
                "closePanel": { "type": "string", "minLength": 1 },
                "eyebrowLearning": { "type": "string", "minLength": 1 },
                "eyebrowSpecial": { "type": "string", "minLength": 1 },
                "stillPending": { "type": "string", "minLength": 1 },
                "represents": { "type": "string", "minLength": 1 },
                "howEarned": { "type": "string", "minLength": 1 },
                "howToEarn": { "type": "string", "minLength": 1 },
                "completingTemplate": { "type": "string", "minLength": 1 },
                "completeTemplate": { "type": "string", "minLength": 1 },
                "completeRoute": { "type": "string", "minLength": 1 },
                "routeEarned": { "type": "string", "minLength": 1 },
                "takeaway": { "type": "string", "minLength": 1 },
                "viewLearning": { "type": "string", "minLength": 1 },
                "xpTemplate": { "type": "string", "minLength": 1 },
                "unlocksAtEnd": { "type": "string", "minLength": 1 },
                "memorial": {
                  "type": "object",
                  "required": ["eyebrow", "place", "placeTemplate", "takeaway"],
                  "properties": {
                    "eyebrow": { "type": "string", "minLength": 1 },
                    "place": { "type": "string", "minLength": 1 },
                    "placeTemplate": { "type": "string", "minLength": 1 },
                    "takeaway": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "tabs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "label", "required"],
            "properties": {
              "id": { "enum": ["learning", "reflection", "lived"] },
              "label": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "labels": {
          "type": "object",
          "required": [
            "explore", "markRead", "claimBadge", "close", "index", "reset", "continueRoute",
            "startRoute", "pending", "previous", "next", "progressTemplate", "stationTitleTemplate",
            "semester", "teacher", "sectionRead", "sectionUnread", "badgeEarned", "remainingTemplate", "rewardTitle", "xpTemplate", "levelTemplate", "emptyRouteLabel", "mapLabel",
            "badges", "notEarned", "routeBadgeLocked", "earnedOnTemplate", "badgeCountTemplate", "completionTitle", "finalReflectionTitle", "resetConfirmTitle", "resetConfirmText", "resetConfirm", "cancel", "preparationTemplate",
            "musicMute", "musicUnmute", "stateLocked", "stateAvailable", "stateCompleted", "tapExplore", "tapTravel", "jerryAction", "playerName", "nextBadge", "captionJournal", "captionJerry", "captionSound"
          ],
          "properties": {
            "explore": { "type": "string", "minLength": 1 },
            "markRead": { "type": "string", "minLength": 1 },
            "claimBadge": { "type": "string", "minLength": 1 },
            "close": { "type": "string", "minLength": 1 },
            "index": { "type": "string", "minLength": 1 },
            "reset": { "type": "string", "minLength": 1 },
            "continueRoute": { "type": "string", "minLength": 1 },
            "startRoute": { "type": "string", "minLength": 1 },
            "pending": { "type": "string", "minLength": 1 },
            "demo": { "type": "string", "minLength": 1 },
            "previous": { "type": "string", "minLength": 1 },
            "next": { "type": "string", "minLength": 1 },
            "progressTemplate": { "type": "string", "minLength": 1 },
            "stationTitleTemplate": { "type": "string", "minLength": 1 },
            "semester": { "type": "string", "minLength": 1 },
            "teacher": { "type": "string", "minLength": 1 },
            "sectionRead": { "type": "string", "minLength": 1 },
            "sectionUnread": { "type": "string", "minLength": 1 },
            "badgeEarned": { "type": "string", "minLength": 1 },
            "remainingTemplate": { "type": "string", "minLength": 1 },
            "rewardTitle": { "type": "string", "minLength": 1 },
            "xpTemplate": { "type": "string", "minLength": 1 },
            "emptyRouteLabel": { "type": "string", "minLength": 1 },
            "levelTemplate": { "type": "string", "minLength": 1 },
            "mapLabel": { "type": "string", "minLength": 1 },
            "loadingMap": { "type": "string", "minLength": 1 },
            "awayFromStationTemplate": { "type": "string", "minLength": 1 },
            "badges": { "type": "string", "minLength": 1 },
            "notEarned": { "type": "string", "minLength": 1 },
            "routeBadgeLocked": { "type": "string", "minLength": 1 },
            "earnedOnTemplate": { "type": "string", "minLength": 1 },
            "badgeCountTemplate": { "type": "string", "minLength": 1 },
            "completionTitle": { "type": "string", "minLength": 1 },
            "finalReflectionTitle": { "type": "string", "minLength": 1 },
            "finalReflectionPending": { "type": "string", "minLength": 1 },
            "resetConfirmTitle": { "type": "string", "minLength": 1 },
            "resetConfirmText": { "type": "string", "minLength": 1 },
            "resetConfirm": { "type": "string", "minLength": 1 },
            "cancel": { "type": "string", "minLength": 1 },
            "preparationTemplate": { "type": "string", "minLength": 1 },
            "musicMute": { "type": "string", "minLength": 1 },
            "musicUnmute": { "type": "string", "minLength": 1 },
            "stateLocked": { "type": "string", "minLength": 1 },
            "stateAvailable": { "type": "string", "minLength": 1 },
            "stateCompleted": { "type": "string", "minLength": 1 },
            "tapExplore": { "type": "string", "minLength": 1 },
            "tapTravel": { "type": "string", "minLength": 1 },
            "jerryAction": { "type": "string", "minLength": 1 },
            "playerName": { "type": "string", "minLength": 1 },
            "nextBadge": { "type": "string", "minLength": 1 },
            "captionJournal": { "type": "string", "minLength": 1 },
            "captionJerry": { "type": "string", "minLength": 1 },
            "captionSound": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "assets": {
          "type": "object",
          "required": ["window", "button", "stationSign", "titleSign", "portrait", "xpBar", "glow", "badgesButton", "listButton", "musicButton", "jerryButton"],
          "properties": {
            "window": { "$ref": "#/$defs/assetId" },
            "button": { "$ref": "#/$defs/assetId" },
            "buttonHover": { "$ref": "#/$defs/assetId" },
            "stationSign": { "$ref": "#/$defs/assetId" },
            "titleSign": { "$ref": "#/$defs/assetId" },
            "portrait": { "$ref": "#/$defs/assetId" },
            "xpBar": { "$ref": "#/$defs/assetId" },
            "xpStar": { "$ref": "#/$defs/assetId" },
            "openBook": { "$ref": "#/$defs/assetId" },
            "lockIcon": { "$ref": "#/$defs/assetId" },
            "glow": { "$ref": "#/$defs/assetId" },
            "badgesButton": { "$ref": "#/$defs/assetId" },
            "listButton": { "$ref": "#/$defs/assetId" },
            "musicButton": { "$ref": "#/$defs/assetId" },
            "jerryButton": { "$ref": "#/$defs/assetId" },
            "xpStarEffect": { "$ref": "#/$defs/assetId" },
            "nextStationGlow": { "$ref": "#/$defs/assetId" },
            "statusPanel": { "$ref": "#/$defs/assetId" },
            "musicMutedButton": { "$ref": "#/$defs/assetId" },
            "completedBadge": { "$ref": "#/$defs/assetId" },
            "exitSign": { "$ref": "#/$defs/assetId" },
            "stationSparkle": { "$ref": "#/$defs/assetId" },
            "avatarAnimations": { "$ref": "#/$defs/assetId" }
          },
          "additionalProperties": false
        },
        "defaultDialogueIds": {
          "type": "object",
          "required": ["open", "locked", "completed", "reward"],
          "properties": {
            "open": { "$ref": "#/$defs/id" },
            "locked": { "$ref": "#/$defs/id" },
            "completed": { "$ref": "#/$defs/id" },
            "reward": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "actor": {
      "type": "object",
      "required": ["assetId", "origin", "scale", "animations"],
      "properties": {
        "assetId": { "$ref": "#/$defs/assetId" },
        "origin": { "$ref": "#/$defs/normalizedPoint" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "animations": {
          "type": "object",
          "properties": {
            "idle": { "type": "string", "minLength": 1 },
            "walkUp": { "type": "string", "minLength": 1 },
            "walkDown": { "type": "string", "minLength": 1 },
            "walkLeft": { "type": "string", "minLength": 1 },
            "walkRight": { "type": "string", "minLength": 1 },
            "celebrate": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gameplay": {
      "type": "object",
      "required": ["progressionMode", "zoneTravel", "start", "playerSpeed", "cameraZoom", "camera", "signScale", "player", "companion"],
      "properties": {
        "progressionMode": { "const": "sequential" },
        "zoneTravel": { "const": "free" },
        "start": {
          "type": "object",
          "required": ["zoneId", "spawnId"],
          "properties": { "zoneId": { "$ref": "#/$defs/id" }, "spawnId": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        "playerSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "cameraZoom": { "type": "number", "exclusiveMinimum": 0 },
        "camera": {
          "type": "object",
          "required": ["fit", "maxZoom", "minPlayerHeight"],
          "properties": {
            "fit": { "enum": ["cover", "fixed"] },
            "maxZoom": { "type": "number", "exclusiveMinimum": 0 },
            "minPlayerHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "signScale": { "type": "number", "exclusiveMinimum": 0 },
        "player": {
          "type": "object",
          "required": ["assetId", "origin", "scale", "animations", "body"],
          "properties": {
            "assetId": { "$ref": "#/$defs/assetId" },
            "origin": { "$ref": "#/$defs/normalizedPoint" },
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "animations": { "$ref": "#/$defs/actor/properties/animations" },
            "shadow": {
              "type": "object",
              "required": ["alpha", "widthFactor", "aspect"],
              "properties": {
                "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "widthFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "aspect": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "idle": {
              "type": "object",
              "required": ["rest", "glance", "play", "glanceAfterMs", "playAfterMs", "gestureCooldownMs"],
              "properties": {
                "rest": { "$ref": "#/$defs/assetId" },
                "glance": { "$ref": "#/$defs/assetId" },
                "play": { "$ref": "#/$defs/assetId" },
                "glanceAfterMs": { "type": "number", "exclusiveMinimum": 0 },
                "playAfterMs": { "type": "number", "exclusiveMinimum": 0 },
                "gestureCooldownMs": { "type": "number", "minimum": 0 },
                "tricks": {
                  "type": "object",
                  "required": ["sheet"],
                  "properties": { "sheet": { "$ref": "#/$defs/assetId" } },
                  "additionalProperties": false
                },
                "fetch": {
                  "type": "object",
                  "required": ["sheet", "holdMs"],
                  "properties": { "sheet": { "$ref": "#/$defs/assetId" }, "holdMs": { "type": "number", "minimum": 0 } },
                  "additionalProperties": false
                },
                "actionKey": { "type": "string", "pattern": "^[A-Z]$" }
              },
              "additionalProperties": false
            },
            "body": {
              "type": "object",
              "required": ["width", "height", "offset"],
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "offset": { "$ref": "#/$defs/point" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "companion": {
          "type": "object",
          "required": ["mode", "followDistance"],
          "properties": {
            "mode": { "enum": ["separate", "included"] },
            "actor": { "$ref": "#/$defs/actor" },
            "followDistance": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
